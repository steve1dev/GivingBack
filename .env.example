# ============================================================
#  Giving Back — Variables de Entorno
#  Copia este archivo, renómbralo a .env y llena los valores
#  NUNCA subas .env a GitHub (ya está en .gitignore)
# ============================================================

# --- InsForge (SDK cliente) ---
# Usa el host de .insforge/project.json (oss_host)
VITE_INSFORGE_URL=https://TU-APPKEY.us-east.insforge.app

# Obtén esta clave con: npx @insforge/cli secrets get ANON_KEY
VITE_INSFORGE_ANON_KEY=TU_ANON_KEY

# --- App ---
VITE_APP_URL=http://localhost:5173
